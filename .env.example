# Nukopijuok į .env serveryje. Šio failo į Git dėti nereikia.
# Naudok sukurtos tuščios MySQL duomenų bazės prisijungimo duomenis.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Prisijungimas adresu /admin/. Slaptažodis: bent 12 ženklų, iki 128 baitų.
# Reikšmes su #, tarpais arba = rašyk tarp kabučių. $ ženklas nekeičiamas.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Lentelės ir pradinis žodynas sukuriami automatiškai.
# APP_SECRET ir ADMIN_PASSWORD_HASH generuoti nereikia.
